# EventOS — copy to .env.local and fill in.
# Never commit .env.local. Every value below is validated at build time by
# src/config/env.ts; a missing or malformed one fails the build, not a request.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EventOS

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses every guard — never expose to the browser, never commit.
SUPABASE_SECRET_KEY=

# Storage bucket (create it in Storage → New bucket, public).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=eventos-public

# ---------------------------------------------------------------------------
# Database — Project Settings → Database → Connection string
# ---------------------------------------------------------------------------
# Pooled (Transaction mode, port 6543). Used by the running application.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Direct (port 5432). Used by migrations — PgBouncer cannot run DDL reliably.
DIRECT_DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Set to true only after enabling Google in Supabase → Authentication → Providers.
# The sign-in page hides the Google button while this is false.
AUTH_GOOGLE_ENABLED=false

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Reserved for later phases. Leave blank in Phase 0.
# ---------------------------------------------------------------------------
# Phase 3 — transactional email (merchant invitations)
EMAIL_PROVIDER=supabase
RESEND_API_KEY=
EMAIL_FROM=

# Phase 1 — rate limiting; Phase 3 — job queue
REDIS_URL=

# Phase 6 — billing
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 7 — observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# CI only. Lets `pnpm build` and `pnpm lint` run without production secrets.
# Never set this in development, staging, or production.
# ---------------------------------------------------------------------------
# SKIP_ENV_VALIDATION=true

# debug | info | warn | error
# LOG_LEVEL=debug
